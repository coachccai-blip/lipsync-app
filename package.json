{
  "name": "avatar-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Avatar Studio : voix ou texte -> vidéo d'un personnage 3D cartoon en lip sync (buste dans une bulle, fond vert ou transparent).",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "inspect-model": "node scripts/inspect-model.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verif-marionnette": "node scripts/verif-marionnette.mjs",
    "build": "npm run build:node && npm run build:player",
    "build:node": "tsc -b packages/shared packages/pipeline packages/renderer packages/cli",
    "build:player": "npm run build -w @avatar/player",
    "build:pages": "npm run build:pages -w @avatar/player",
    "dev:player": "npm run dev -w @avatar/player",
    "avatar": "node packages/cli/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/shared packages/pipeline packages/renderer packages/cli && tsc -p packages/player --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
