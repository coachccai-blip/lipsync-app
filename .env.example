# Azure Speech (mode B, synthèse vocale)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
# Voix HD ; température de la voix (0 = stable, 1 = expressive)
AZURE_TTS_VOICE=fr-FR-Vivienne:DragonHDLatestNeural
AZURE_TTS_TEMPERATURE=0.7

# Annotation des expressions et gestes (API Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Outils externes (facultatif : détectés dans le PATH ou dans tools/ sinon)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# RHUBARB_PATH=tools/rhubarb/rhubarb
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=tools/whisper/ggml-small.bin
# CHROME_PATH=/usr/bin/google-chrome
